# Copy to .env and fill in values

# App
APP_NAME=Portfolio API
DEBUG=false

# CORS (optional; defaults include http://localhost:3000)
FRONTEND_ORIGIN=http://localhost:3000

# Auth — use one of these when you implement auth
# Firebase:
# GOOGLE_APPLICATION_CREDENTIALS=./firebaseServiceKeyJson/firebaseServiceKey.json
# Or inline (e.g. for Docker): FIREBASE_CREDENTIALS={"type":"service_account",...}

# JWT (if you use JWT instead of Firebase):
# JWT_SECRET=your-secret-at-least-32-chars
